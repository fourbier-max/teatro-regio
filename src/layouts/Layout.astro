---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { termin } from '../texte/termin.mdx';

// Social Preview (Open Graph / Twitter)
const name = 'teatro regio';
const titel = 'teatro regio – Theater zwischen Leinetal und Weserbergland';
const beschreibung =
	'Theater zwischen Leinetal und Weserbergland: Wir laden die Bewohnerinnen und Bewohner der Region zum Theaterspiel ein.';
const url = new URL(Astro.url.pathname, Astro.site).href;
const vorschaubild = new URL('/preview.jpg', Astro.site).href;

// Strukturierte Daten für Google: der Verein und – solange er noch bevorsteht – der aktuelle Termin
const verein = {
	'@type': 'PerformingGroup',
	name: 'teatro regio e. V.',
	url: Astro.site!.href,
	image: vorschaubild,
	email: 'info@teatro-regio.de',
	description: beschreibung,
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Vor dem Tore 11',
		postalCode: '37181',
		addressLocality: 'Hardegsen',
		addressCountry: 'DE',
	},
	areaServed: 'Leinetal und Weserbergland',
};

const daten: object[] = [verein];
if (new Date(termin.beginn) > new Date()) {
	daten.push({
		'@type': 'Event',
		name: termin.name,
		startDate: termin.beginn,
		eventStatus: 'https://schema.org/EventScheduled',
		eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
		location: {
			'@type': 'Place',
			name: termin.ort,
			address: termin.adresse,
		},
		organizer: { '@type': 'PerformingGroup', name: verein.name, url: verein.url },
		url: `${Astro.site!.href}#aktuelles`,
		image: vorschaubild,
	});
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': daten });
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="format-detection" content="telephone=no" />{/* sonst markiert iOS z. B. die IBAN als Telefonnummer – echte Nummern als tel:-Link schreiben */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{titel}</title>
		<meta name="description" content={beschreibung} />
		<link rel="canonical" href={url} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={name} />
		<meta property="og:title" content={titel} />
		<meta property="og:description" content={beschreibung} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={vorschaubild} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={titel} />
		<meta name="twitter:description" content={beschreibung} />
		<meta name="twitter:image" content={vorschaubild} />

		<script type="application/ld+json" set:html={jsonLd} />

		<Font cssVariable="--font-text" preload={[{ weight: "400", style: "normal" }]} />
		<Font cssVariable="--font-heading" preload={[{ weight: "400", style: "normal" }]} />
	</head>
	<body>
		<slot />
	</body>
</html>
