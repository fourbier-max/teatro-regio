---
import { Image } from 'astro:assets';
import sturm1 from '../assets/img/sturm_1.jpg';
import sturm2 from '../assets/img/sturm_2.jpg';
import sturm3 from '../assets/img/sturm_3.jpg';
import himmelblau1 from '../assets/img/himmelblau_1.jpg';
import himmelblau2 from '../assets/img/himmelblau_2.jpg';
import spaziergang1 from '../assets/img/spaziergang_1.jpg';
import spaziergang3 from '../assets/img/spaziergang_3.jpg';
import spaziergang2 from '../assets/img/spaziergang_2.jpg';

const bilder = [
    { src: sturm1, titel: 'Der Sturm, 2023' },
    { src: sturm2, titel: 'Der Sturm, 2023' },
    { src: sturm3, titel: 'Der Sturm, 2023' },
    { src: himmelblau1, titel: 'Himmelblau, 2024' },
    { src: himmelblau2, titel: 'Himmelblau, 2024' },
    { src: spaziergang1, titel: 'Der schönste Tag, 2022' },
    { src: spaziergang3, titel: 'Der schönste Tag, 2022' },
    { src: spaziergang2, titel: 'Der schönste Tag, 2022' },
];
---

<div class="galerie swiper">
    <div class="swiper-wrapper">
        {bilder.map((bild) => (
            <figure class="swiper-slide">
                <Image src={bild.src} alt={bild.titel} widths={[600, 1200]} sizes="(max-width: 600px) 90vw, 800px" />
                <figcaption class="label">{bild.titel}</figcaption>
            </figure>
        ))}
    </div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-pagination"></div>
</div>

<script>
    import Swiper from 'swiper';
    import { Navigation, Keyboard, Pagination } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';

    document.querySelectorAll<HTMLElement>('.galerie').forEach((el) => {
        new Swiper(el, {
            modules: [Navigation, Keyboard, Pagination],
            slidesPerView: 'auto',
            spaceBetween: 12,
            centeredSlides: true,
            loop: true,
            keyboard: { enabled: true },
            navigation: {
                nextEl: el.querySelector<HTMLElement>('.swiper-button-next'),
                prevEl: el.querySelector<HTMLElement>('.swiper-button-prev'),
            },
            pagination: {
                el: el.querySelector<HTMLElement>('.swiper-pagination'),
                clickable: true,
            },
        });
    });
</script>

<style>
    .galerie {
        /* Pfeile über Swipers eigene Variablen – direktes left/right/margin-top überschreibt Swiper */
        --swiper-navigation-color: black;
        --swiper-navigation-size: var(--knopf); /* so breit wie der Menü-Button */
        --swiper-navigation-sides-offset: var(--inset);
        /* Pfeile mittig zum Bild, nicht zum ganzen Slider (Bildunterschrift abziehen) */
        --swiper-navigation-top-offset: calc(50% - (var(--caption-height) + var(--pagination-height)) / 2);
        --galerie-height: 90vh;
        --caption-height: 30px;
        /* Pagination: graue Punkte, aktives Bild in Highlight-Farbe */
        --swiper-pagination-color: var(--color-highlight);
        --swiper-pagination-bullet-inactive-color: #ddd;
        --swiper-pagination-bullet-inactive-opacity: 1;
        --swiper-pagination-bottom: 12px;
        /* Platz unter der Bildunterschrift für die Punkte */
        --pagination-height: 20px;
        box-sizing: border-box;
        width: 100%;
        height: var(--galerie-height);
        padding: 12px 0 calc(12px + var(--pagination-height));
    }
    .swiper-button-prev,
    .swiper-button-next {
        box-sizing: border-box;
        padding: calc(var(--swiper-navigation-size) * 0.3); /* Pfeil wächst mit (18px bei 60px) */
        background: var(--color-clickable);
        border-radius: 40px;
        transition: color 0.2s;
    }
    .swiper-button-prev:hover,
    .swiper-button-next:hover {
        color: white;
    }
    .swiper-slide {
        width: auto;
        margin: 0;
    }
    .swiper-slide img {
        display: block;
        width: auto;
        /* Galeriehöhe minus Innenabstand (2 × 12px), Bildunterschrift und Pagination */
        height: calc(var(--galerie-height) - 24px - var(--caption-height) - var(--pagination-height));
        max-width: 90vw;
        object-fit: cover;
    }
    figcaption {
        box-sizing: border-box;
        height: var(--caption-height);
        padding-top: 6px;
    }
    @media (max-width: 600px) {
        .galerie {
            --galerie-height: 50vh;
        }
    }
</style>
