---
import { Image } from 'astro:assets';
import woodsPano from '../assets/img/woods-pano.jpg';
---

<Image class="flaeche" src={woodsPano} alt="" widths={[600, 1200, 2000]} sizes="100vw" />

<style>
    .flaeche {
        margin-top: 160px;
        margin-bottom: 80px;
        display: block;
        width: 100%;
        height: 300px;
        object-fit: cover;
        filter: brightness(50%);
    }
</style>
